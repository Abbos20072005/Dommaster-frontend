
# Google Tag Manager container (GA4 and Yandex Metrika are connected inside it)
NEXT_PUBLIC_GTM_ID=

# AI assistant window (BLD-406). The button is on every page. DISABLED=1 takes it off the site;
# MOCK=1 answers with a made-up assistant (to look at the design, no backend needed). While the chat
# endpoint (BLD-400) is not live, the window says it is temporarily unavailable and gives the phone.
NEXT_PUBLIC_ASSISTANT_DISABLED=
NEXT_PUBLIC_ASSISTANT_MOCK=
